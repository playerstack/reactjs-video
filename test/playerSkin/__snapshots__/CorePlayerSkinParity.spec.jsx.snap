        aria-label="Seek"
        part="slider"
      >
        <div
          part="track"
        >
          <div
            part="track-buffered"
            style="width: 0%;"
          />
          <div
            part="track-hover"
          />
          <div
            part="track-fill"
            style="width: 42%;"
          />
        </div>
        <div
          part="chapters"
          style="display: none;"
        />
        <div
          part="thumb"
          style="left: 42%;"
        />
      </div>
      <div
        part="heatmap"
      >
        <svg
          part="heatmap-svg"
          preserveAspectRatio="none"
          viewBox="0 0 100 100"
        >
          <defs>
            <clippath
              id="playerstack-timeslider-heatmap-2"
            >
              <rect
                height="100"
                width="42"
                x="0"
                y="0"
              />
            </clippath>
          </defs>
          <path
            d=""
            part="heatmap-path"
          />
          <path
            clip-path="url(#playerstack-timeslider-heatmap-2)"
            d=""
            part="heatmap-path-played"
          />
        </svg>
      </div>
      <div
        part="tooltip"
      >
        <div
          part="tooltip-chapter"
          style="display: none;"
        />
        <div
          part="tooltip-time"
        />
      </div>
      <div
        part="timelens"
        style="display: none;"
      />
    </div>
  </playerstack-time-slider>
